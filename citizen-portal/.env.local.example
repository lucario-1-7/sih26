# Copy to .env.local for local development.

# The real FastAPI backend — never a mock.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# MSG91 OTP Widget — client-side config only. Both values are meant to be
# shipped to the browser per MSG91's own "Client Side Integration" panel
# (the same way a payment provider's publishable key is public) — this
# widget can only start an OTP flow, never read account data. The
# account-level MSG91_AUTH_KEY (server-only, in the repo-root .env) must
# never appear here.
NEXT_PUBLIC_MSG91_WIDGET_ID=<msg91-otp-widget-id>
NEXT_PUBLIC_MSG91_TOKEN_AUTH=<msg91-otp-widget-token-auth>

# PRESENTATION-ONLY. Shows a "Continue as Demo Citizen" button on the login
# page that bypasses OTP. OFF unless set to exactly "true". The backend's
# own DEMO_MODE must ALSO be enabled (see repo-root .env) — this flag alone
# never grants access, it only controls whether the button is shown.
NEXT_PUBLIC_DEMO_MODE=true
