# Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PRESENTATION-ONLY. Shows "Continue as Demo <role>" buttons on the login
# page that bypass OTP. OFF unless set to exactly "true". The backend's own
# DEMO_MODE must ALSO be enabled (see repo-root .env) — this flag alone
# never grants access, it only controls whether the buttons are shown.
NEXT_PUBLIC_DEMO_MODE=true
