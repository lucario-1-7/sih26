# PostgreSQL
# NOTE: local development credentials only. Never use these values in production.
POSTGRES_DB=sih26_dev
POSTGRES_USER=sih26
POSTGRES_PASSWORD=<local-development-password>
# NOTE: default changed from 5432 to 5433 in local dev to avoid clashing with
# a native PostgreSQL service that may already be listening on 5432 on the host.
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# Server
# Must match the postgres/redis values above when composed manually for local (non-docker) runs.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5433/<db>
# Separate database, same server — keeps integration test data out of the dev DB.
TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5433/<db>_test
REDIS_URL=redis://localhost:6379
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<local-development-secret-key>
ML_SERVICE_URL=http://localhost:8001
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]

# Which environment this process is running as. This is the ONLY switch that
# selects the OTP delivery path — see "OTP delivery" below. Not "test",
# "staging", or anything else: literally the string "development" or
# "production".
ENVIRONMENT=development

# PRESENTATION-ONLY demo/bypass login (server/app/services/auth_service.py
# DEMO_PERSONAS). OFF by default. Never activates because MSG91 or any
# other real provider failed — it's a separate, explicit opt-in endpoint
# (POST /auth/demo/login), not a fallback. Force-disabled whenever
# ENVIRONMENT=production, regardless of this value. Set to true only for a
# live presentation/demo deployment.
DEMO_MODE=true

# OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Minimum seconds between two OTP requests for the same phone number.
OTP_RESEND_COOLDOWN_SECONDS=30

# --- OTP delivery — MSG91 OTP Widget ----------------------------------------
#
# Two integration modes coexist behind the same backend, for two different
# call sites:
#
#   1. Client-driven (citizen-portal web + Flutter — the primary path):
#      the widget runs entirely in the client using WIDGET_ID + TOKEN_AUTH,
#      MSG91 generates/delivers/verifies the OTP there directly, and hands
#      the client a temporary access-token. The client sends ONLY that
#      token to POST /api/v1/auth/customer/msg91/verify; the backend's one
#      job is confirming it with MSG91 (POST .../widget/verifyAccessToken,
#      using MSG91_AUTH_KEY) and issuing the normal Sahyog JWT pair. See
#      app/services/otp_msg91.py:verify_widget_access_token.
#
#   2. Server-driven (organizational portal, POST /auth/otp/request+verify):
#      the backend itself calls MSG91's sendOtpMobile/verifyOtp using
#      WIDGET_ID + TOKEN_AUTH server-side. See
#      app/services/otp_sender.py:NativeOtpProvider.
#
# WIDGET_ID and TOKEN_AUTH are what MSG91's own dashboard labels "Client
# Side Integration" — safe to ship to a browser/mobile app, the same way a
# payment provider's publishable key is meant to be public (this widget
# can only start an OTP flow, never read account data). MSG91_AUTH_KEY is
# the real account secret — it is used ONLY by the backend, for the
# server-to-server verifyAccessToken call, and must never reach the client.
#
# Development (ENVIRONMENT=development):
#   The server-driven path falls back to console/dev-OTP retrieval
#   (GET /api/v1/auth/dev/otp?phone=...) unless MSG91_WIDGET_ID and
#   MSG91_TOKEN_AUTH are both set. The client-driven path always needs real
#   MSG91 configuration (WIDGET_ID/TOKEN_AUTH shipped to the client,
#   AUTH_KEY on the backend) — there is no offline/dev fallback for it,
#   since the OTP never touches this backend at all in that flow.
#
# Production (ENVIRONMENT=production):
#   The server-driven path always uses MSG91 — not configurable. If
#   WIDGET_ID/TOKEN_AUTH is missing, those OTP requests fail with a 503
#   (OTP_DELIVERY_UNAVAILABLE) rather than silently falling back to console
#   logging. The dev-retrieval endpoint does not exist in this mode.
#
# MSG91 setup requirements (do this before setting these variables):
#   1. Create an MSG91 account and complete Indian DLT (Distributed Ledger
#      Technology) registration — required by TRAI for any transactional/OTP
#      SMS to Indian numbers. Without DLT approval MSG91 will reject sends
#      even with a correctly configured widget.
#   2. In the MSG91 dashboard, create an OTP Widget (not a plain SMS
#      template) and complete its DLT-linked SMS template as part of the
#      widget setup wizard.
#   3. From the widget's configuration page, copy:
#        - the Widget ID  -> MSG91_WIDGET_ID   (safe for client code)
#        - the Token Auth -> MSG91_TOKEN_AUTH  (safe for client code)
#   4. From account Settings -> API, copy the Auth Key -> MSG91_AUTH_KEY
#      (server-only — never put this in Flutter, the citizen web bundle,
#      or any client-side config).
#
# Do NOT add MSG91_TEMPLATE_ID — the Widget flow never uses a raw SMS
# template id directly; that's configured once inside the widget itself.
MSG91_WIDGET_ID=<msg91-otp-widget-id>
MSG91_TOKEN_AUTH=<msg91-otp-widget-token-auth>
MSG91_AUTH_KEY=<msg91-account-auth-key>

# Citizen web frontend build-time config (see citizen-portal/.env.local.example)
# mirrors WIDGET_ID/TOKEN_AUTH as NEXT_PUBLIC_* — that duplication is
# intentional (a browser bundle can't read server-only .env values), not a
# second source of truth. MSG91_AUTH_KEY is never mirrored anywhere.

# ML service
ML_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

