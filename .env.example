# PostgreSQL
# NOTE: local development credentials only. Never use these values in production.
POSTGRES_DB=sih26_dev
POSTGRES_USER=sih26
POSTGRES_PASSWORD=<local-development-password>
# NOTE: default changed from 5432 to 5433 in local dev to avoid clashing with
# a native PostgreSQL service that may already be listening on 5432 on the host.
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# Server
# Must match the postgres/redis values above when composed manually for local (non-docker) runs.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5433/<db>
# Separate database, same server — keeps integration test data out of the dev DB.
TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5433/<db>_test
REDIS_URL=redis://localhost:6379
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<local-development-secret-key>
ML_SERVICE_URL=http://localhost:8001
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ML service
ML_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

